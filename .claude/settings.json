{
  "worktree": {
    "baseRef": "head",
    "symlinkDirectories": ["node_modules", "admin/node_modules"]
  },
  "permissions": {
    "ask": [
      "Edit(**/.github/**)",
      "Write(**/.github/**)",
      "Edit(**/.claude/settings*.json)",
      "Write(**/.claude/settings*.json)",
      "Edit(**/.claude/hooks/**)",
      "Write(**/.claude/hooks/**)",
      "Read(**/.env*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-build-check.sh\"",
            "timeout": 120,
            "statusMessage": "빌드 검사 중..."
          }
        ]
      }
    ]
  }
}
